# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only – never prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=            # AI interpretation, replies, assistant (pay-per-use)
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=                 # Speech-to-text (Whisper) – free tier available
GROQ_STT_MODEL=whisper-large-v3   # optional; whisper-large-v3-turbo is faster but less accurate
